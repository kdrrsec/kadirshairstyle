# Postgres-database voor het reserveringssysteem (bijv. Vercel Postgres / Neon)
DATABASE_URL=postgres://user:password@host:5432/database

# Wachtwoord voor /admin (afsprakenoverzicht)
ADMIN_PASSWORD=kies-een-sterk-wachtwoord

# Publieke URL van de website (voor SEO, sitemap en Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.kadirshairstyle.nl

# Geheime code voor het TV-scherm (/scherm?code=...)
SCREEN_TOKEN=kies-een-lange-willekeurige-code

# WhatsApp naar de kapper: melding bij een nieuwe afspraak + dagoverzicht (via AxaWeb Meldingen, optioneel)
# De kapper stuurt "START <naam>" naar het AxaWeb-afzendnummer en krijgt de apikey terug.
WHATSAPP_PHONE=31612345678
WHATSAPP_APIKEY=

# Agenda beheren via WhatsApp (BLOKKEER, AFSPRAAK, AGENDA, ...): zelfde geheim als bij de
# webhook in AxaWeb Meldingen. Alleen WHATSAPP_PHONE (of deze nummers) mag commando's geven.
WHATSAPP_WEBHOOK_SECRET=
# WHATSAPP_BEHEER_NUMMERS=31612345678,31687654321

# Beveiligt het dagelijkse overzicht (/api/cron/dagoverzicht); Vercel stuurt dit mee
CRON_SECRET=kies-een-lange-willekeurige-code

# Cloudflare Turnstile ("ik ben een mens"-vinkje bij online boeken, optioneel)
# Aanmaken op dash.cloudflare.com > Turnstile; zonder deze sleutels staat het vinkje uit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Schakelaar "We gaan binnenkort live" (zie proxy.ts). COMING_SOON=1 toont iedereen
# /binnenkort; met https://<domein>/?voorbeeld=<COMING_SOON_SECRET> zie je de echte site.
COMING_SOON=0
COMING_SOON_SECRET=
